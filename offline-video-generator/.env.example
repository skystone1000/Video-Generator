APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite:///./data/app.db
OUTPUT_DIR=./data/outputs
THUMBNAIL_DIR=./data/thumbnails
LOG_DIR=./data/logs

VIDEO_RUNTIME=mock
MOCK_SAMPLE_MP4_PATH=

# ── HunyuanVideo-1.5 ──────────────────────────────────────────────────────────
# Both paths must be absolute. Models live outside the project — on any drive.
# See docs/models_setup.md for what to download and where to place files.

# Absolute path to the cloned HunyuanVideo-1.5 code repository (contains generate.py)
# Example: HUNYUAN_15_REPO_PATH=C:\AI\HunyuanVideo-1.5
# Example: HUNYUAN_15_REPO_PATH=E:\models\HunyuanVideo-1.5
HUNYUAN_15_REPO_PATH=

# Absolute path to the downloaded model checkpoints folder (the ckpts directory)
# Example: HUNYUAN_15_MODEL_PATH=E:\models\HunyuanVideo-1.5\ckpts
# Example: HUNYUAN_15_MODEL_PATH=D:\AI\checkpoints\HunyuanVideo-1.5
HUNYUAN_15_MODEL_PATH=

HUNYUAN_15_TORCHRUN_PATH=.venv/Scripts/torchrun.exe
HUNYUAN_15_NPROC_PER_NODE=1
HUNYUAN_15_ENABLE_SR=false
HUNYUAN_15_USE_SAGE_ATTN=false
HUNYUAN_15_ENABLE_CACHE=false

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

MAX_ACTIVE_JOBS=1
DEFAULT_PRESET=standard
